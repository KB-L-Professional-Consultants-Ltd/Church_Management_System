# Get this from Neon -> Project Dashboard -> Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require
# Use the direct Neon connection string here for migrations if the pooler URL fails.
DATABASE_URL_MIGRATE=postgresql://username:password@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: Nest port for local API run
PORT=3000
