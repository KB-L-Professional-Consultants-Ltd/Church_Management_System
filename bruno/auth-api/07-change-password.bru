meta {
  name: change-password
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{userPassword}}",
    "newPassword": "P@ssw0rd2!",
    "currentRefreshToken": "{{refreshToken}}"
  }
}
