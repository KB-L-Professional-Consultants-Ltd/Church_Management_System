{
  "name": "church_management_system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/nextjs/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter nextjs exec eslint --max-warnings=0",
      "prettier --write"
    ],
    "apps/api/**/*.{ts,js}": [
      "pnpm --filter api exec eslint --max-warnings=0"
    ],
    "packages/ui/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter ui exec eslint --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0"
  }
}
